# Build-time flags for the deployed (GitHub Pages) build. Committed on purpose: flags only, never put secrets here.
# Compare against a finished .dxf is on. Set to false for a freemium build that leaves it off.
VITE_FEATURE_COMPARE=true
# AI deed reading sends page images to a model provider through the local backend (npm run server). Off in the deployed build.
VITE_FEATURE_AI_READ=false
