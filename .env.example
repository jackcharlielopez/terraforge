# Feature flags (build-time). Anything but false/0/off/no leaves a feature on.
# VITE_FEATURE_COMPARE=false

# AI deed reading (opt-in; sends page images to a model provider). Needs the local backend: `npm run server`.
# VITE_FEATURE_AI_READ=true
# Server-side only, read by server/index.mjs from .env or .env.local (both gitignored). Never prefix with VITE_.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5
